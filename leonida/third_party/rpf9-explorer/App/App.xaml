<Application x:Class="RpfPreview.App.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,5"/><Setter Property="MinHeight" Value="28"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="5,3"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="TreeViewItem"><Setter Property="Padding" Value="3,4"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="6,3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="7,6"/><Setter Property="FontWeight" Value="Normal"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="12,5"/></Style>
 </Application.Resources>
</Application>
