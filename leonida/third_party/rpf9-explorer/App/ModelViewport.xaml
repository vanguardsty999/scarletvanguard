<UserControl x:Class="RpfPreview.App.ModelViewport"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Focusable="True" KeyDown="Viewport_KeyDown">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#23262B" ClipToBounds="True" MouseDown="Scene_MouseDown" MouseMove="Scene_MouseMove" MouseUp="Scene_MouseUp" MouseWheel="Scene_MouseWheel" LostMouseCapture="Scene_LostMouseCapture">
   <Viewport3D x:Name="Scene" SizeChanged="Scene_SizeChanged">
    <Viewport3D.Camera><PerspectiveCamera x:Name="Camera" FieldOfView="42" NearPlaneDistance="0.001" FarPlaneDistance="10000000"/></Viewport3D.Camera>
    <ModelVisual3D><ModelVisual3D.Content><Model3DGroup>
     <AmbientLight Color="#656970"/>
     <DirectionalLight Color="#F5F5F5" Direction="-1,-2,-3"/>
     <DirectionalLight Color="#A9BCCB" Direction="2,1,2"/>
    </Model3DGroup></ModelVisual3D.Content></ModelVisual3D>
    <ModelVisual3D x:Name="GeometryRoot"/>
   </Viewport3D>
  </Border>
  <DockPanel Grid.Row="1" Margin="7,5">
   <Button DockPanel.Dock="Right" Content="Reset view" Click="Reset_Click" Padding="9,3"/>
   <TextBlock x:Name="ModelInfoText" Text="Drag: orbit · right-drag: pan · wheel: zoom" Foreground="#666" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
  </DockPanel>
 </Grid>
</UserControl>
